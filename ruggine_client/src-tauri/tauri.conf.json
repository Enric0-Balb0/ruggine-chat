{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruggine Chat",
  "version": "0.1.0",
  "identifier": "com.ruggine.chat",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ruggine Chat",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Real-time chat application",
    "longDescription": "Ruggine Chat - a modern, real-time, multi-platform chat client built in Rust with Leptos and Tauri.",
    "publisher": "Ruggine Team",
    "copyright": "Copyright © 2025 Ruggine Team",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/150x150.png",
      "icons/284x284.png",
      "icons/310x310.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Ruggine Chat"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "localhost",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "epoch": 0
      }
    }
  }
}
