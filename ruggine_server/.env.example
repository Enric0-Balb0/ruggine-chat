# Database Configuration
POSTGRES_PASSWORD=ruggine_secure_password_change_this

# JWT Configuration  
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_TTL_IN_MINUTES=1440

# Server Configuration
PORT=8002
SERVER_HOST=0.0.0.0
SERVER_PORT=8002

# Performance Monitoring
LOG_IN_MILLISECONDS=120000
ENABLE_CPU_LOGGING=true
CPU_LOG_INTERVAL_MINUTES=2

# Application Environment
RUST_ENV=production
RUST_LOG=info

# Database URLs
DATABASE_URL=postgresql://ruggine_user:${POSTGRES_PASSWORD}@ruggine_db:5432/ruggine_prod
TEST_DATABASE_URL=postgresql://ruggine_user:${POSTGRES_PASSWORD}@ruggine_db:5432/ruggine_test