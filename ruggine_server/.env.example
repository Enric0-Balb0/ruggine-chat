# Database Configuration
POSTGRES_PASSWORD=password

# JWT Configuration  
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_TTL_IN_MINUTES=1440

# Server Configuration
PORT=8002
SERVER_HOST=0.0.0.0
SERVER_PORT=8002

# Performance Monitoring
LOG_IN_MILLISECONDS=120000

# Application Environment
RUST_ENV=production
RUST_LOG=info

# Database URLs (Docker will override these)
DATABASE_URL=postgres://postgres:password@localhost:5432/ruggine
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/ruggine_test