# High Performance Configuration for 16 cores / 16GB RAM
# Use this file with: docker-compose --env-file .env.high-performance up

# Database Configuration
POSTGRES_PASSWORD=ruggine_ultra_secure_production_password_2024
POSTGRES_DB=ruggine_prod
POSTGRES_USER=ruggine_user

# JWT Configuration
JWT_SECRET=ultra_secure_jwt_secret_for_high_performance_production_env_2024_change_this
JWT_TTL_IN_MINUTES=1440

# Server Performance Settings
RUST_LOG=info
TOKIO_WORKER_THREADS=8
RUST_BACKTRACE=0

# CPU Monitoring (reduced interval for high-performance monitoring)
ENABLE_CPU_LOGGING=true
LOG_IN_MILLISECONDS=60000
CPU_LOG_INTERVAL_MINUTES=1

# Optional Services Passwords
REDIS_PASSWORD=redis_ultra_secure_password_2024
GRAFANA_PASSWORD=grafana_admin_secure_password_2024

# Performance Tuning Environment Variables
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD_=131072
MALLOC_TRIM_THRESHOLD_=131072
MALLOC_TOP_PAD_=131072
MALLOC_MMAP_MAX_=65536
