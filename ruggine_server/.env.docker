# Database Configuration - Docker specific
DATABASE_URL=postgresql://ruggine_user:ruggine_secure_password@ruggine_db:5432/ruggine_prod
POSTGRES_PASSWORD=ruggine_secure_password

# JWT Configuration  
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_TTL_IN_MINUTES=1440

# Server Configuration
PORT=8002
SERVER_HOST=0.0.0.0
SERVER_PORT=8002

# Performance Monitoring
LOG_IN_MILLISECONDS=120000

# Application Environment
RUST_ENV=production
RUST_LOG=info
