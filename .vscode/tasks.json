{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "ruggine_server"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: Run All Tests",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--", "--nocapture"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_server"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: Run Unit Tests",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--lib", "--", "--nocapture"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_server"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: Run Integration Tests",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--test", "*", "--", "--nocapture"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_server"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: Run Test by Name",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "${input:testName}", "--", "--nocapture"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_server"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Tauri: Build Client",
      "type": "shell",
      "command": "cargo",
      "args": ["tauri", "build"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Tauri: Dev Client",
      "type": "shell",
      "command": "cargo",
      "args": ["tauri", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Trunk: Serve Frontend",
      "type": "shell",
      "command": "trunk",
      "args": ["serve", "--open"],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Generate API Types",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./generate-types.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Generate API Types (Simple)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./generate-simple-types.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Tailwind: Watch CSS",
      "type": "shell",
      "command": "npx",
      "args": [
        "tailwindcss",
        "-i", "./src/styles/index.css",
        "-o", "./src/styles/tailwind.css",
        "--watch",
        "--poll"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Tailwind: Build CSS",
      "type": "shell",
      "command": "npx",
      "args": [
        "tailwindcss",
        "-i", "./src/styles/index.css",
        "-o", "./src/styles/tailwind.css",
        "--minify"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ruggine_client"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start All Frontend",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tailwind: Build CSS",
        "Dev: Start Services"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Services",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Trunk: Serve Frontend",
        "Tailwind: Watch CSS"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
    ,
    {
      "label": "Client: Clean Installers",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy","Bypass","-Command",
        "if (Test-Path 'target/release/bundle') { Remove-Item -Recurse -Force 'target/release/bundle'; Write-Host 'Old installers removed.' } else { Write-Host 'No previous bundle directory.' }"
      ],
      "options": { "cwd": "${workspaceFolder}/ruggine_client" },
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Client: Build WASM Release",
      "type": "shell",
      "command": "trunk",
      "args": ["build","--release"],
      "options": { "cwd": "${workspaceFolder}/ruggine_client" },
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Client: Build Tauri Installer",
      "type": "shell",
      "command": "cargo",
      "args": ["tauri","build"],
      "options": { "cwd": "${workspaceFolder}/ruggine_client" },
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Client: Build Installers",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Client: Clean Installers",
        "Tailwind: Build CSS",
        "Client: Build WASM Release",
        "Client: Build Tauri Installer"
      ],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "description": "Test name or pattern",
      "default": "",
      "type": "promptString"
    }
  ]
}
